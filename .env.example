# 复制为 .env 后填写：cp .env.example .env
# 必须设置 POSTGRES_PASSWORD，否则 docker compose 会拒绝启动

POSTGRES_DB=activity_booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=

# 宿主机端口（容器内始终 5432）。默认 5433，避开本机已有 Postgres / 其他项目占用
POSTGRES_HOST_PORT=5433

# 时区
TZ=Asia/Shanghai

# 后端（SQLAlchemy / Alembic）。密码与 POSTGRES_PASSWORD 保持一致
DATABASE_URL=postgresql+psycopg://booking:<password>@127.0.0.1:5433/activity_booking

# 镜像（compose 不能自动换源：拉失败时取消下面一行注释）
# POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine

# 微信网页授权（后续填写；都空则走 mock 登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=
WECHAT_OAUTH_STATE_SECRET=

# Session Cookie
SESSION_COOKIE_NAME=ab_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
H5_ORIGIN=http://127.0.0.1:5173
