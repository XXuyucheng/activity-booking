# 复制为 .env 后填写：cp .env.example .env
# 必须设置 POSTGRES_PASSWORD，否则 docker compose 会拒绝启动

POSTGRES_DB=activity_booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=

# 宿主机端口（容器内始终 5432）。默认 5433，避开本机已有 Postgres / 其他项目占用
POSTGRES_HOST_PORT=5433

# FastAPI 映射到宿主机的端口（容器内始终 8000）。本机不要再跑占 8000 的 uvicorn
BACKEND_HOST_PORT=8000

# 时区
TZ=Asia/Shanghai

# 本机 alembic / 本机 uvicorn / DBeaver 用（连 127.0.0.1:5433）。
# Compose 里的 backend 会覆盖为 postgres:5432，不要把下面这行当成容器内连接串
DATABASE_URL=postgresql+psycopg://booking:<password>@127.0.0.1:5433/activity_booking

# 镜像（compose 不能自动换源：拉失败时取消下面相应行注释）
# POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine
# BACKEND_BASE_IMAGE=docker.1ms.run/library/python:3.12-slim

# 微信网页授权（后续填写；都空则走 mock 登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=
WECHAT_OAUTH_STATE_SECRET=

# 模板消息（后续填写；缺模板 ID 则只写 notification_logs，不调微信）
WECHAT_TPL_BOOKING_SUCCESS=
WECHAT_TPL_BOOKING_CANCEL=
WECHAT_TPL_BOOKING_REMINDER=

# Session Cookie
SESSION_COOKIE_NAME=ab_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
H5_ORIGIN=http://127.0.0.1:5173
